{
  "name": "replay-games-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RePlay Games - API REST con Express, MySQL y JWT (EP2)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
