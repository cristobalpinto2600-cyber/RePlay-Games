# Copia este archivo como .env en la raíz antes de ejecutar "docker compose up --build".
# NO subas el archivo .env con tus claves reales a GitHub.

# Base de datos MySQL (el puerto externo 3307 evita choque con XAMPP si usa 3306).
MYSQL_ROOT_PASSWORD=
DB_NAME=replay_games
DB_EXTERNAL_PORT=3307

# API REST Backend
BACKEND_PORT=3000
# Clave secreta para JWT (mínimo 32 caracteres). Puedes generarla con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
AUTH_MAX_INTENTOS=20
API_MAX_PETICIONES=200

# Integración externa RAWG (opcional; obtén tu clave gratuita en https://rawg.io/apidocs)
RAWG_API_KEY=
RAWG_API_URL=https://api.rawg.io/api
RAWG_TIMEOUT_MS=5000

# Frontend Web (Nginx)
FRONTEND_PORT=8080
VITE_API_URL=http://localhost:3000/api
