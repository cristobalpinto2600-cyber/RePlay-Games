# Copia este archivo como .env y completa los valores. El archivo .env NO se sube al repositorio.

# Puerto donde escucha la API.
PORT=3000

# Conexión a MySQL / MariaDB (XAMPP usa por defecto el usuario root sin contraseña).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=replay_games

# Clave para firmar los JWT: usa un texto largo y aleatorio (mínimo 32 caracteres).
# Puedes generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración del token (formato de jsonwebtoken: 30m, 2h, 1d...).
JWT_EXPIRES_IN=2h

# Orígenes del frontend autorizados por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173,http://localhost:8100

# Intentos fallidos de login/registro permitidos por IP cada 15 minutos.
AUTH_MAX_INTENTOS=20
